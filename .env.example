# SMTP server used by the contact form (src/routes/contact/+page.server.ts).
# Copy to .env for local development. In production Coolify supplies the values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=contact@raqz.pl
SMTP_PASS=change-me
# Envelope sender. Keep it on a domain the SMTP server is allowed to send for.
SMTP_FROM=contact@raqz.pl
# Where the form messages arrive.
CONTACT_TO=hello@raqz.pl
